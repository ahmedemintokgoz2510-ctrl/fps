{
  "name": "arkadas-fps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arkadaşlar online 3D taktik FPS",
  "scripts": {
    "start": "node server.js",
    "prepare-www": "node scripts/prepare-www.js",
    "android:prepare": "npm run prepare-www && npx cap add android && npx cap sync android",
    "android:build": "npm run android:prepare && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "devDependencies": {
    "three": "0.160.0",
    "@capacitor/core": "6.1.2",
    "@capacitor/cli": "6.1.2",
    "@capacitor/android": "6.1.2"
  }
}
